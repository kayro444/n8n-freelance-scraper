      "name": "Format Google",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        800,
        -304
      ],
      "parameters": {
        "jsCode": "return ($input.item.json.places || []).map(p => ({ name: p.title, category: p.category, phone: p.phoneNumber, website: p.website, address: p.address, url: p.link || p.url }));"
      }
