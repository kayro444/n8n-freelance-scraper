    {
      "id": "d250e845-7666-4b67-9f8e-977d12d996f4",
      "name": "Yandex Apify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        608,
        -96
      ],
      "parameters": {
        "requestMethod": "POST",
        "url": "https://api.apify.com/v2/acts/zen-studio~yandex-maps-scraper/run-sync-get-dataset-items?token=YOUR_APIFY_API_TOKEN",
        "jsonParameters": true,
        "bodyParametersJson": "={{ JSON.stringify({ query: [ $json.query + \" \" + $json.location ], maxResults: 20 }) }}",
        "options": {}
      }
    },
    {
      "id": "a5341be0-4ec7-42ca-ac02-58be65cd1087",
      "name": "Format Yandex",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        800,
        -96
      ],
      "parameters": {
        "jsCode": "\nconst results = [];\nfor (const i of $input.all()) {\n  const data = Array.isArray(i.json) ? i.json : (i.json.data || [i.json]);\n  for (const item of data) {\n    let cat = 'Нет категории';\n    if (item.categories && item.categories.length > 0) {\n      cat = item.categories[0].name || item.categories[0];\n    }\n    let ph = '';\n    if (item.phones && item.phones.length > 0) {\n      ph = item.phones[0].number || item.phones[0];\n    }\n    results.push({\n      json: {\n        name: item.title || item.name || 'Нет названия',\n        category: cat,\n        phone: ph,\n        website: item.website || '',\n        address: item.address || '',\n        url: item.url || ''\n      }\n    });\n  }\n}\nreturn results;\n"
      }
    },
