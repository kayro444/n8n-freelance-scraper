    {
      "id": "842b5eef-bf71-4c89-ae25-87d53aacdbac",
      "name": "Parse Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        208,
        0
      ],
      "parameters": {
        "jsCode": "\nlet text = ($json.chatInput || \"\").trim();\nlet source = \"google\";\nlet query = text;\nlet location = \"Москва\";\n\nconst match = text.match(/^(kwork|кворк|2gis|2гис|yandex|яндекс|google|гугл)[\\s:]+(.*)/i);\nif(match) {\n   let s = match[1].toLowerCase();\n   if (s === 'кворк') source = 'kwork';\n   else if (s === '2гис') source = '2gis';\n   else if (s === 'яндекс') source = 'yandex';\n   else if (s === 'гугл') source = 'google';\n   else source = s;\n   query = match[2].trim();\n}\n\nlet parts = query.split(\" \");\nif(parts.length > 1 && source !== 'kwork') {\n   location = parts.slice(1).join(\" \");\n   query = parts[0];\n}\n\nreturn { source, query, location, text };\n"
      }
    },
    {
      "id": "afc0f8ac-f384-40dc-9884-1b64293e920e",
