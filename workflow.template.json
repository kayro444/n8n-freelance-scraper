        800,
        112
      ],
      "parameters": {
        "jsCode": "\nconst results = [];\nfor (const i of $input.all()) {\n  const data = Array.isArray(i.json) ? i.json : (i.json.data || [i.json]);\n  for (const item of data) {\n    results.push({\n      json: {\n        name: item.name || item.nameShort || 'Нет названия',\n        category: item.categoryPrimary || (item.categories && item.categories[0]) || 'Нет категории',\n        phone: item.phone || (item.phones && item.phones[0]) || '',\n        website: item.website || (item.websites && item.websites[0]) || '',\n        address: item.address || item.addressFull || '',\n        url: item.url || ''\n      }\n    });\n  }\n}\nreturn results;\n"
      }
